<?xml version="1.0"?>
<sdf version="1.6">
  <!-- 红色苹果🍎：半径 0.022m（≈4.4cm，与 4cm 绿方块体量相当），60g，
       接触参数照搬 target_box（kp=500 / μ=2.0 / 隐式弹簧阻尼），
       保证在同样的物理世界里不抖、不穿地。颜色饱和红，便于腕部相机与 VLM 区分。 -->
  <model name="red_apple">
    <pose>0 0 0.022 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.06</mass>
        <inertia>
          <ixx>1.16e-05</ixx><iyy>1.16e-05</iyy><izz>1.16e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry><sphere><radius>0.022</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          <contact><ode>
            <kp>500.0</kp>
            <max_vel>0.01</max_vel><min_depth>0.0005</min_depth>
            <implicit_spring_damper>true</implicit_spring_damper><kd>10.0</kd>
          </ode></contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry><sphere><radius>0.022</radius></sphere></geometry>
        <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
