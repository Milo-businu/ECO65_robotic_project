       =========================================================== --><link name="camera_link"><visual><geometry><box size="0.09 0.025 0.025"/></geometry><material name="cam_blue"><color rgba="0.1 0.2 0.8 1"/></material></visual><inertial><mass value="0.05"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="2e-4"/></inertial></link><joint name="camera_joint" type="fixed"><parent link="Link6"/><child link="camera_link"/><origin rpy="0 0 0" xyz="0.09 0 0.05"/></joint><gazebo reference="camera_link"><sensor name="wrist_depth_camera" type="depth"><update_rate>5</update_rate><camera><horizontal_fov>1.204</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.28</near><far>3.0</far></clip></camera><plugin filename="libgazebo_ros_camera.so" name="wrist_camera_plugin"><frame_name>camera_link</frame_name></plugin></sensor></gazebo></robot>