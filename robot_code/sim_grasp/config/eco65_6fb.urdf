       =========================================================== --><link name="gripper_base"><visual><origin rpy="0 0 0" xyz="0.0828 0 0"/><geometry><box size="0.1655 0.063 0.063"/></geometry><material name="grip_gray"><color rgba="0.35 0.35 0.35 1"/></material></visual><collision><origin rpy="0 0 0" xyz="0.0828 0 0"/><geometry><box size="0.1655 0.063 0.063"/></geometry></collision><inertial><origin rpy="0 0 0" xyz="0.0828 0 0"/><mass value="0.37"/><inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.00097" iyz="0" izz="0.00097"/></inertial></link><joint name="gripper_joint" type="fixed"><parent link="Link6"/><child link="gripper_base"/><origin rpy="0 0 0" xyz="0 0 0"/></joint><!-- 左指：铰链 (0.1655, +0.02)，绕 +z 转 --><link name="finger_left"><visual><origin rpy="0 0 0" xyz="0.025 0 0"/><geometry><box size="0.05 0.008 0.03"/></geometry><material name="finger_red"><color rgba="0.8 0.3 0.2 1"/></material></visual><collision><origin rpy="0 0 0" xyz="0.025 0 0"/><geometry><box size="0.05 0.008 0.03"/></geometry></collision><inertial><origin rpy="0 0 0" xyz="0.025 0 0"/><mass value="0.02"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial></link><joint name="finger_left_joint" type="revolute"><parent link="gripper_base"/><child link="finger_left"/><origin rpy="0 0 0" xyz="0.1655 0.02 0"/><axis xyz="0 0 1"/><dynamics damping="5.0" friction="0.1"/><limit effort="5.0" lower="-0.2" upper="0.6" velocity="1.0"/></joint><!-- 右指：铰链 (0.1655, -0.02)，绕 +z 转（指令取反即对称开合） --><link name="finger_right"><visual><origin rpy="0 0 0" xyz="0.025 0 0"/><geometry><box size="0.05 0.008 0.03"/></geometry><material name="finger_red"><color rgba="0.8 0.3 0.2 1"/></material></visual><collision><origin rpy="0 0 0" xyz="0.025 0 0"/><geometry><box size="0.05 0.008 0.03"/></geometry></collision><inertial><origin rpy="0 0 0" xyz="0.025 0 0"/><mass value="0.02"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial></link><joint name="finger_right_joint" type="revolute"><parent link="gripper_base"/><child link="finger_right"/><origin rpy="0 0 0" xyz="0.1655 -0.02 0"/><axis xyz="0 0 1"/><dynamics damping="5.0" friction="0.1"/><limit effort="5.0" lower="-0.6" upper="0.2" velocity="1.0"/></joint><!-- 夹爪 TCP：指尖高度（TCP_OFF=0.2155） --><link name="gripper_tcp"/><joint name="tcp_joint" type="fixed"><parent link="gripper_base"/><child link="gripper_tcp"/><origin rpy="0 0 0" xyz="0.2155 0 0"/></joint><!-- 指尖高摩擦，模拟柔性爪的橡胶指面，便于真正夹住 --><gazebo reference="finger_left"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo><gazebo reference="finger_right"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo><!-- ===========================================================
